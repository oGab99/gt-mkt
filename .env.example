# ─────────────────────────────────────────────────────────────
# GT Studio · variáveis de ambiente
# Copie para .env (desenvolvimento) e preencha. Nunca faça commit do .env.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL
DATABASE_URL="postgresql://gtstudio:gtstudio@localhost:5432/gtstudio?schema=public"

# URL pública da aplicação (em produção, obrigatoriamente https://)
APP_URL="http://localhost:3000"

# Segredo usado para assinar os cookies de sessão (mínimo 32 caracteres).
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# true apenas se a aplicação estiver atrás de um proxy reverso confiável
# (Vercel, Nginx, Cloudflare...). Habilita o limite de tentativas por IP.
TRUST_PROXY="false"

# ── Conta administrativa inicial (usada por `npm run db:seed`) ──
ADMIN_EMAIL="ogab.dev99@gmail.com"
ADMIN_USERNAME="gabriel"
ADMIN_NAME="Gabriel Teixeira"
# Em desenvolvimento, se vazio, a senha temporária é 123456.
# Em produção é obrigatória e precisa ser forte (12+ caracteres, maiúscula,
# minúscula, número e símbolo).
ADMIN_INITIAL_PASSWORD=""
# true força a senha temporária de novo (e encerra as sessões do admin)
ADMIN_RESET_PASSWORD="false"

# ── E-mail (recuperação de senha) ──
# Sem SMTP_HOST, SMTP_PORT e MAIL_FROM a tela "Esqueci minha senha" informa que
# a recuperação ainda não está disponível. Funciona com qualquer SMTP
# (Resend, Amazon SES, SendGrid, Brevo, Google Workspace...).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="GT Studio <no-reply@seudominio.com.br>"

# ── Agência (usada por `npm run db:seed`) ──
# Nome da agência criada no primeiro seed. Depois, edite em Configurações > Administração.
AGENCY_NAME="GT Studio"

# ── Arquivos enviados (logos, fotos, anexos, mídias) ──
# Pasta privada fora de /public. Os arquivos só são entregues pela rota
# autenticada /api/arquivos/[id]. Em produção, use um volume persistente.
STORAGE_DIR="./storage"

# ── Integrações (Instagram, Facebook, TikTok, YouTube) ──
# Ainda não conectadas nesta versão (aparecem como "Não configurada").
# Chave de 32 bytes em base64 que cifrará os tokens OAuth (AES-256-GCM).
# Gere com: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""
# Credenciais dos apps oficiais, quando a conexão OAuth for ativada:
# META_APP_ID=""
# META_APP_SECRET=""
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
